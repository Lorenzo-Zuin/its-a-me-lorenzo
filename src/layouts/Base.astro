---
import { ClientRouter } from 'astro:transitions';
import Testata from '@/components/Testata.astro';
import Pie from '@/components/Pie.astro';
import '@/styles/global.css';

interface Props {
  titolo: string;
  descrizione?: string;
}

const { titolo, descrizione = 'Lorenzo Zuin, software engineer a Venezia. Siti, app e programmi che ho fatto e che farò.' } = Astro.props;
const titoloCompleto = titolo === 'Home' ? 'Lorenzo Zuin' : `${titolo} · Lorenzo Zuin`;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloCompleto}</title>
    <meta name="description" content={descrizione} />
    <meta name="theme-color" content="#f6f7fb" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Urbanist:wght@600;700;800;900&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap"
    />
    <ClientRouter />
  </head>
  <body>
    <Testata />
    <main>
      <slot />
    </main>
    <Pie />
    <div class="copertura" aria-hidden="true"></div>
    <script>
      // All'arrivo da una transizione di scena la pagina nuova parte coperta dello stesso colore
      // dell'ultimo fotogramma e si svela (vedi global.css, `html[data-arrivo]`).
      // Il dato si applica al documento nuovo prima dello scambio, così non c'è nessun fotogramma scoperto.
      // Vale solo per la navigazione della scena che l'ha salvato (`navigate(dest, { info: { scena } })`):
      // un link, Indietro o un ricaricamento durante la scena arrivano senza copertura.
      import { TransitionBeforeSwapEvent } from 'astro:transitions/client';
      const CHIAVI = ['arrivo', 'arrivo-x', 'arrivo-y', 'arrivo-r'] as const;
      let timer = 0;
      const scenaDi = (info: unknown): string | null =>
        typeof info === 'object' && info !== null && 'scena' in info && typeof info.scena === 'string' ? info.scena : null;
      const applica = (doc: Document, scena: string | null) => {
        const arrivo = sessionStorage.getItem('arrivo');
        const x = sessionStorage.getItem('arrivo-x') ?? '50%';
        const y = sessionStorage.getItem('arrivo-y') ?? '50%';
        const r = sessionStorage.getItem('arrivo-r') ?? '120vmax';
        CHIAVI.forEach((k) => sessionStorage.removeItem(k));
        if (!arrivo || arrivo !== scena) return;
        const radice = doc.documentElement;
        radice.dataset.arrivo = arrivo;
        radice.style.setProperty('--arrivo-x', x);
        radice.style.setProperty('--arrivo-y', y);
        radice.style.setProperty('--arrivo-r', r);
        window.clearTimeout(timer);
        // Dal caffè `main` sta sopra la copertura (z-index 41) e quindi anche sopra il piè di pagina:
        // si chiude appena finiti il cerchio (0,8 s) e i testi che salgono (0,94 s), così il piè non resta nascosto.
        const durata = arrivo === 'caffe' ? 1000 : 1600;
        timer = window.setTimeout(() => {
          delete document.documentElement.dataset.arrivo;
          document.documentElement.style.removeProperty('--arrivo-x');
          document.documentElement.style.removeProperty('--arrivo-y');
          document.documentElement.style.removeProperty('--arrivo-r');
        }, durata);
      };
      // Al caricamento completo non c'è nessuna scena in volo: eventuali dati rimasti si buttano.
      applica(document, null);
      document.addEventListener('astro:before-swap', (e) => {
        if (e instanceof TransitionBeforeSwapEvent) applica(e.newDocument, scenaDi(e.info));
      });
    </script>
  </body>
</html>
