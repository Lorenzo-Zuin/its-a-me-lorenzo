---
import { ClientRouter } from 'astro:transitions';
import Testata from '@/components/Testata.astro';
import Pie from '@/components/Pie.astro';
import '@/styles/global.css';

interface Props {
  titolo: string;
  descrizione?: string;
}

const { titolo, descrizione = 'Lorenzo Zuin, software engineer a Venezia. Siti, app e programmi che ho fatto e che farò.' } = Astro.props;
const titoloCompleto = titolo === 'Home' ? 'Lorenzo Zuin' : `${titolo} · Lorenzo Zuin`;
---

<!doctype html>
<html lang="it" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloCompleto}</title>
    <meta name="description" content={descrizione} />
    <meta name="theme-color" content="#f6f7fb" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Urbanist:wght@600;700;800;900&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap"
    />
    <ClientRouter />
    <script is:inline>
      // Prima del primo disegno: segnala che le animazioni d'ingresso ci saranno (vedi global.css).
      (() => {
        const segna = () => {
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('moto');
        };
        segna();
        document.addEventListener('astro:after-swap', segna);
        // se lo script delle animazioni non parte, il contenuto non deve restare nascosto
        setTimeout(() => { if (!window.motoPronto) document.documentElement.classList.remove('moto'); }, 4000);
      })();
    </script>
  </head>
  <body>
    <Testata />
    <main>
      <slot />
    </main>
    <Pie />
    <div class="scena" id="scena" aria-hidden="true" transition:persist></div>
    <script>
      import { avviaScena } from '@/lib/scena';
      import { avviaPagina } from '@/lib/pagina';
      avviaScena();
      avviaPagina();
    </script>
  </body>
</html>
