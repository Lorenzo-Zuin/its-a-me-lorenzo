---
import Base from '@/layouts/Base.astro';

const esperimenti = [
  { nome: '[Esperimento 1]', riga: '[Un giocattolo, una prova, un prototipo.]', colore: 'var(--verde)' },
  { nome: '[Esperimento 2]', riga: '[Una riga su cosa fa.]', colore: 'var(--viola)' },
  { nome: '[Esperimento 3]', riga: '[Una riga su cosa fa.]', colore: 'var(--oro-scuro)' },
];
---

<Base titolo="Esperimenti" descrizione="Prove, prototipi e giocattoli di Lorenzo Zuin.">
  <section class="pagina contenitore">
    <div class="pagina__testa">
      <a class="bottone bottone--chiaro torna" href="/">← Torna al tavolo</a>
      <p class="etichetta-mono">Esperimenti</p>
      <h1 class="titolo">Cose che provo, prima che diventino progetti.</h1>
      <p class="intro">[Due righe: qui finiscono le prove, i prototipi e i giocattoli. Alcuni crescono, altri restano qui.]</p>
    </div>
    <div class="griglia-schede sezioni">
      {esperimenti.map((e) => (
        <article class="scheda">
          <p class="etichetta-mono" style={`color:${e.colore}`}>Prototipo</p>
          <p><strong>{e.nome}</strong></p>
          <p class="segnaposto">{e.riga}</p>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .torna { align-self: flex-start; font-family: var(--font-mono); font-size: 12px; letter-spacing: .08em; font-weight: 500; padding: 10px 16px; }
  .sezioni { margin-top: 32px; }
</style>
