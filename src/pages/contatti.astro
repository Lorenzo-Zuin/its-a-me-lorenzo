---
import Base from '@/layouts/Base.astro';

const canali = [
  { nome: 'Email', valore: '[INDIRIZZO]', href: '#' },
  { nome: 'GitHub', valore: 'Lorenzo-Zuin', href: 'https://github.com/Lorenzo-Zuin' },
  { nome: 'LinkedIn', valore: '[PROFILO]', href: '#' },
];
---

<Base titolo="Contatti" descrizione="Scrivi a Lorenzo Zuin: email, GitHub, LinkedIn.">
  <section class="pagina contenitore">
    <div class="pagina__testa">
      <a class="bottone bottone--chiaro torna" href="/">← Torna al tavolo</a>
      <p class="etichetta-mono">Contatti</p>
      <h1 class="titolo">Prendiamo un caffè?</h1>
      <p class="intro">Per un progetto, una domanda o una chiacchiera. Rispondo volentieri.</p>
    </div>
    <ul class="canali">
      {canali.map((c) => (
        <li>
          <a class="canale" href={c.href}>
            <strong>{c.nome}</strong>
            <span class="etichetta-mono">{c.valore}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .torna { align-self: flex-start; font-family: var(--font-mono); font-size: 12px; letter-spacing: .08em; font-weight: 500; padding: 10px 16px; }
  .canali { list-style: none; margin: 28px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; max-width: 560px; }
  .canale { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 20px; border-radius: 16px; background: var(--carta); box-shadow: var(--ombra-morbida); text-decoration: none; color: var(--inchiostro); font-weight: 700; transition: transform .2s var(--curva-arrivo); }
  .canale:hover { transform: translateY(-2px); color: var(--inchiostro); }
  .canale .etichetta-mono { text-transform: none; }
</style>
