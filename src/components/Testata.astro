---
import Musica from '@/components/Musica.tsx';
import Orologio from '@/components/Orologio.tsx';

const voci = [
  { href: '/#collezione', testo: 'Collezione' },
  { href: '/esperimenti', testo: 'Esperimenti' },
  { href: '/chi-sono', testo: 'Chi sono' },
  { href: '/contatti', testo: 'Contatti' },
];
// in produzione il percorso finisce con «/»: si toglie per il confronto con le voci
const percorso = Astro.url.pathname.replace(/(.)\/$/, '$1');
---

<header class="testata contenitore">
  <a href="/" class="testata__logo" aria-label="Home">L<span>Z</span></a>
  <nav class="testata__nav" aria-label="Principale">
    {voci.map((v) => (
      <a href={v.href} aria-current={percorso === v.href ? 'page' : undefined}>{v.testo}</a>
    ))}
  </nav>
  <div class="testata__strumenti">
    <span class="testata__ora etichetta-mono">
      VENEZIA · <Orologio client:idle />
    </span>
    <Musica client:idle transition:persist />
  </div>
</header>

<style>
  .testata {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 20px;
    padding-bottom: 20px;
  }
  .testata__logo {
    text-decoration: none;
    color: var(--inchiostro);
    font-family: var(--font-titoli);
    font-weight: 900;
    font-size: 22px;
    letter-spacing: -0.03em;
  }
  .testata__logo span { color: var(--corallo); }
  .testata__nav { display: flex; gap: 2px; flex-wrap: wrap; }
  .testata__nav a {
    text-decoration: none;
    color: var(--inchiostro);
    font-size: 14px;
    font-weight: 600;
    padding: 9px 14px;
    border-radius: 999px;
    position: relative;
  }
  .testata__nav { position: relative; }
  /* la pillola è creata dallo script (src/lib/pagina.ts) e scorre tra le voci */
  .testata__nav :global(.testata__pillola) {
    position: absolute; left: 0; top: 0; border-radius: 999px; pointer-events: none; visibility: hidden;
    background: var(--carta); box-shadow: 0 2px 10px rgba(26, 29, 43, 0.08);
  }
  /* senza animazioni la voce corrente resta comunque evidenziata */
  :global(html:not(.moto)) .testata__nav a:hover, :global(html:not(.moto)) .testata__nav a[aria-current='page'] {
    background: var(--carta);
    box-shadow: 0 2px 10px rgba(26, 29, 43, 0.08);
  }
  :global(html.moto) .testata__logo, :global(html.moto) .testata__nav a, :global(html.moto) .testata__strumenti > :global(*) { visibility: hidden; }
  .testata__logo { display: inline-block; }
  .testata__strumenti { display: flex; align-items: center; gap: 14px; }
  .testata__ora { white-space: nowrap; }
  @media (max-width: 480px) {
    .testata__nav { order: 3; width: 100%; }
  }
</style>
