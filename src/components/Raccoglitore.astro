---
import { progetti, INDICI, type Progetto } from '@/data/progetti';

const simboli: Record<Progetto['tipo'], string> = {
  app: '<circle cx="6" cy="6" r="5"/><circle cx="6" cy="6" r="2"/>',
  sito: '<circle cx="6" cy="6" r="5"/><path d="M1 6h10M6 1c2 2 2 8 0 10M6 1c-2 2-2 8 0 10"/>',
  repository: '<circle cx="3" cy="3" r="2"/><circle cx="3" cy="9" r="2"/><circle cx="9" cy="9" r="2"/><path d="M3 5v2M4.5 9h2.5"/>',
  programma: '<rect x="2.5" y="2.5" width="7" height="7" rx="1.5"/><path d="M4.5 1v1.5M7.5 1v1.5M4.5 9.5V11M7.5 9.5V11M1 4.5h1.5M1 7.5h1.5M9.5 4.5H11M9.5 7.5H11"/>',
  idea: '',
};
const chiara = (p: Progetto) => p.colore === 'var(--carta)';
---

<section id="collezione" class="raccoglitore contenitore">
  <div class="raccoglitore__testa">
    <h2 class="titolo">Il raccoglitore</h2>
  </div>
  <div class="griglia" data-griglia>
    {progetti.map((p) => (
      <a
        class:list={['carta', `carta--${p.tessera}`, { 'carta--chiara': chiara(p), 'carta--libera': p.stato === 'in arrivo' }]}
        href={p.href}
        data-musica={p.musica}
        style={`--colore:${p.colore}`}
        aria-label={`${p.nome}: ${p.riga}`}
      >
        {p.stato !== 'in arrivo' && <span class="cornice" aria-hidden="true"></span>}
        {p.stato !== 'in arrivo' && (
          <span class="ind" aria-hidden="true">
            <span>{INDICI[p.tipo]}</span>
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" set:html={simboli[p.tipo]} />
          </span>
        )}
        {p.tessera === '2x2' && (
          <span class="ind ind--giu" aria-hidden="true">
            <span>{INDICI[p.tipo]}</span>
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" set:html={simboli[p.tipo]} />
          </span>
        )}
        <span class="carta__sopra">
          {p.stato === 'in arrivo' ? (
            <span class="etichetta-mono carta__stato carta__stato--oro">posto libero</span>
          ) : p.tessera === '2x2' ? (
            <span class="etichetta-mono carta__stato carta__stato--pill">{p.tipo} · {p.stato}</span>
          ) : null}
        </span>
        {p.id === 'bucklet' && (
          <span class="barre" aria-hidden="true">
            <i style="height:40%"></i><i style="height:65%"></i><i style="height:50%"></i><i style="height:90%;background:var(--oro)"></i><i style="height:70%"></i><i style="height:55%"></i><i style="height:80%;background:rgba(255,255,255,.9)"></i>
          </span>
        )}
        {p.schermata && <span class="carta__schermata etichetta-mono">{p.schermata}</span>}
        <span class="carta__testo">
          <span class:list={['carta__nome', { 'carta__nome--mono': p.id === 'lorenzozuin-com' }]}>
            {p.nome}
            {p.id === 'lorenzozuin-com' && <i class="cursore" aria-hidden="true"></i>}
          </span>
          <span class="carta__riga">{p.riga}</span>
        </span>
        {p.tessera === '2x1' && p.stato === 'in corso' && (
          <span class="etichetta-mono carta__stato carta__stato--oro carta__stato--angolo">in corso</span>
        )}
        {p.olografia && <span class={`olo olo-${p.olografia}`} aria-hidden="true"></span>}
        <span class="bagliore" aria-hidden="true"></span>
      </a>
    ))}
    <a class="carta carta--1x1 carta--tutta" href="/collezione" data-musica="tutto" aria-label="Tutta la collezione">
      <span class="cornice cornice--oro" aria-hidden="true"></span>
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="var(--oro)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 14h18M15 6l8 8-8 8"/></svg>
      <span class="carta__testo"><span class="carta__nome carta__nome--oro">Tutta la collezione</span></span>
      <span class="olo olo-oro" aria-hidden="true"></span>
      <span class="bagliore" aria-hidden="true"></span>
    </a>
  </div>
</section>

<style>
  .raccoglitore { display: flex; flex-direction: column; gap: 20px; padding-top: 8px; padding-bottom: 56px; }
  .raccoglitore__testa { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 12px; }
  .raccoglitore h2 { font-size: 34px; letter-spacing: -0.03em; }

  .griglia {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 200px;
    gap: 16px;
    perspective: 1600px;
  }
  .carta--2x2 { grid-column: span 2; grid-row: span 2; }
  .carta--1x2 { grid-row: span 2; }
  .carta--2x1 { grid-column: span 2; }

  .carta {
    --mx: 50%; --my: 50%; --rx: 0deg; --ry: 0deg;
    position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; gap: 4px;
    padding: 22px; border-radius: 20px; text-decoration: none;
    background: var(--colore); color: #fff;
    box-shadow: 0 1px 2px rgba(26, 29, 43, 0.08), 0 14px 30px -14px color-mix(in srgb, var(--colore) 70%, transparent);
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    transition: transform 0.25s ease-out, box-shadow 0.3s;
    animation: entra 0.7s var(--curva-arrivo) both;
  }
  .carta:nth-child(1){animation-delay:.05s}.carta:nth-child(2){animation-delay:.12s}.carta:nth-child(3){animation-delay:.19s}.carta:nth-child(4){animation-delay:.26s}.carta:nth-child(5){animation-delay:.33s}.carta:nth-child(6){animation-delay:.4s}.carta:nth-child(7){animation-delay:.47s}
  @keyframes entra { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  .carta:hover, .carta:focus-visible { box-shadow: 0 40px 60px -20px rgba(26, 29, 43, 0.45); color: #fff; outline: none; }
  .carta:focus-visible { box-shadow: 0 0 0 3px var(--blu), 0 40px 60px -20px rgba(26, 29, 43, 0.45); }
  .carta--2x2 { padding: 28px; justify-content: space-between; }
  .carta--chiara, .carta--chiara:hover { color: var(--inchiostro); }
  .carta--chiara { box-shadow: var(--ombra-morbida); }
  .carta--libera { background: var(--carta); border: 1.5px dashed #c3c8d6; box-shadow: none; }
  .carta--tutta { background: var(--inchiostro); justify-content: space-between; }
  .carta--tutta, .carta--tutta:hover { color: #fff; }
  .carta--tutta::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(circle at 20% 30%, rgba(255,255,255,.9) 1px, transparent 1.6px), radial-gradient(circle at 70% 20%, rgba(255,255,255,.7) 1px, transparent 1.6px), radial-gradient(circle at 40% 70%, rgba(255,255,255,.8) 1.2px, transparent 1.8px), radial-gradient(circle at 80% 60%, rgba(255,255,255,.6) 1px, transparent 1.6px), radial-gradient(circle at 55% 45%, rgba(255,255,255,.9) 1px, transparent 1.6px), radial-gradient(circle at 15% 80%, rgba(255,255,255,.6) 1px, transparent 1.6px), radial-gradient(circle at 90% 85%, rgba(255,255,255,.8) 1px, transparent 1.6px);
  }

  .cornice { position: absolute; inset: 8px; border: 1.5px solid rgba(255,255,255,.55); border-radius: 14px; pointer-events: none; }
  .carta--2x2 .cornice { inset: 10px; }
  .carta--chiara .cornice { border-color: var(--linea); }
  .cornice--oro { border-color: rgba(232,179,60,.6); }

  .ind { position: absolute; top: 20px; left: 20px; display: flex; flex-direction: column; align-items: center; gap: 2px; font-family: var(--font-titoli); font-weight: 900; font-size: 18px; line-height: 1; letter-spacing: -0.02em; }
  .ind svg { width: 12px; height: 12px; }
  .carta--2x2 .ind { top: 22px; left: 22px; font-size: 22px; }
  .ind--giu { top: auto; left: auto; bottom: 22px; right: 22px; transform: rotate(180deg); }
  .carta--chiara .ind { color: var(--blu); }

  .carta__sopra { display: flex; justify-content: flex-end; }
  .carta__stato { font-size: 11px; }
  .carta__stato--pill { padding: 6px 10px; border-radius: 999px; background: rgba(255,255,255,.18); color: #fff; }
  .carta__stato--oro { color: var(--oro-scuro); position: absolute; top: 20px; left: 20px; }
  .carta__stato--angolo { top: auto; left: auto; bottom: 22px; right: 22px; padding: 6px 10px; border-radius: 999px; background: #fbf1dc; }

  .barre { display: flex; align-items: flex-end; gap: 10px; height: 140px; padding: 0 40px; }
  .barre i { flex: 1; border-radius: 8px 8px 4px 4px; background: rgba(255,255,255,.4); transform-origin: bottom; animation: cresce 1.4s var(--curva-arrivo) both; }
  .barre i:nth-child(1){animation-delay:.5s}.barre i:nth-child(2){animation-delay:.6s}.barre i:nth-child(3){animation-delay:.7s}.barre i:nth-child(4){animation-delay:.8s}.barre i:nth-child(5){animation-delay:.9s}.barre i:nth-child(6){animation-delay:1s}.barre i:nth-child(7){animation-delay:1.1s}
  @keyframes cresce { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  .carta:hover .barre i { animation: ondeggia 1.6s ease-in-out infinite; }
  @keyframes ondeggia { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(.72); } }

  .carta__schermata { position: absolute; left: 24px; right: 24px; top: 64px; bottom: 100px; border-radius: 12px; background: rgba(255,255,255,.16); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 11px; }
  .carta__testo { display: flex; flex-direction: column; gap: 4px; }
  .carta--2x2 .carta__testo { padding-left: 40px; gap: 6px; }
  .carta__nome { font-family: var(--font-titoli); font-weight: 800; font-size: 24px; letter-spacing: -0.02em; line-height: 1.1; }
  .carta--2x2 .carta__nome { font-size: 40px; letter-spacing: -0.03em; }
  .carta--2x1 .carta__nome { font-size: 28px; }
  .carta__nome--mono { font-family: var(--font-mono); font-weight: 500; font-size: 18px; letter-spacing: -0.02em; }
  .carta__nome--oro { color: var(--oro); font-size: 22px; }
  .carta__riga { font-size: 14px; opacity: .92; }
  .carta--2x2 .carta__riga { font-size: 15px; max-width: 380px; }
  .carta--chiara .carta__riga { color: var(--inchiostro-2); opacity: 1; }
  .cursore { display: inline-block; width: 3px; height: 1em; background: currentColor; vertical-align: -0.15em; margin-left: 2px; animation: lampeggia 1s steps(2) infinite; }
  @keyframes lampeggia { to { opacity: 0; } }

  /* Lamina: il riflesso vive solo attorno alla luce (il mouse). */
  .olo {
    position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .45s;
    mix-blend-mode: color-dodge; background-size: 300% 300%;
    background-position: calc(100% - var(--mx)) calc(100% - var(--my));
    -webkit-mask-image: radial-gradient(circle at var(--mx) var(--my), rgba(0,0,0,1) 0%, rgba(0,0,0,.7) 35%, rgba(0,0,0,0) 80%);
    mask-image: radial-gradient(circle at var(--mx) var(--my), rgba(0,0,0,1) 0%, rgba(0,0,0,.7) 35%, rgba(0,0,0,0) 80%);
  }
  .olo::after { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(135deg, rgba(255,255,255,.18) 0 1px, transparent 1px 3px); }
  .carta:hover .olo { opacity: .6; }
  .carta:hover .olo-pioggia { opacity: .55; }
  .olo-cosmos{background-image:radial-gradient(circle at 20% 30%,rgba(255,255,255,.95) 0 1.2px,transparent 2px),radial-gradient(circle at 70% 60%,rgba(255,255,255,.9) 0 1px,transparent 1.8px),radial-gradient(circle at 45% 80%,rgba(255,255,255,.95) 0 1.3px,transparent 2.1px),radial-gradient(circle at 85% 20%,rgba(255,255,255,.8) 0 .9px,transparent 1.7px),radial-gradient(circle at 10% 70%,rgba(255,255,255,.9) 0 1.1px,transparent 1.9px),radial-gradient(circle at 60% 15%,rgba(255,255,255,.95) 0 1.2px,transparent 2px),linear-gradient(115deg,rgba(120,185,255,.85) 0%,rgba(255,150,210,.85) 35%,rgba(140,255,215,.85) 65%,rgba(120,185,255,.85) 100%);background-size:90px 90px,110px 110px,80px 80px,100px 100px,120px 120px,70px 70px,300% 300%}
  .olo-righe{background-image:repeating-linear-gradient(90deg,rgba(255,120,160,.9) 0 5px,rgba(255,220,120,.9) 5px 10px,rgba(120,255,200,.9) 10px 15px,rgba(120,185,255,.9) 15px 20px,rgba(210,140,255,.9) 20px 25px)}
  .olo-galassia{background-image:conic-gradient(from 0deg at 50% 50%,rgba(255,120,160,.9),rgba(255,220,120,.9),rgba(120,255,200,.9),rgba(120,185,255,.9),rgba(210,140,255,.9),rgba(255,120,160,.9));background-size:200% 200%;filter:blur(10px)}
  .olo-oro{background-image:linear-gradient(115deg,rgba(255,225,150,.9) 0%,rgba(255,255,235,1) 45%,rgba(255,215,130,.9) 100%)}
  .olo-ghiaccio{background-image:repeating-linear-gradient(45deg,transparent 0 12px,rgba(255,255,255,.6) 12px 13.5px),repeating-linear-gradient(-45deg,transparent 0 19px,rgba(255,255,255,.5) 19px 20.5px),linear-gradient(115deg,rgba(120,215,255,.9) 0%,rgba(255,255,255,.9) 50%,rgba(180,140,255,.9) 100%);background-size:100% 100%,100% 100%,300% 300%}
  .olo-pioggia{mix-blend-mode:multiply;background-image:repeating-linear-gradient(115deg,rgba(255,255,255,0) 0 9px,rgba(255,255,255,.75) 9px 10px),linear-gradient(115deg,rgba(255,120,160,.9) 0%,rgba(255,220,120,.9) 25%,rgba(120,255,200,.9) 50%,rgba(120,185,255,.9) 75%,rgba(210,140,255,.9) 100%);background-size:100% 100%,300% 300%}
  .bagliore { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .3s; background: radial-gradient(circle at var(--mx) var(--my), rgba(255,255,255,.16), rgba(255,255,255,0) 50%); }
  .carta:hover .bagliore { opacity: 1; }

  @media (max-width: 900px) {
    .griglia { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 170px; gap: 12px; perspective: none; }
    .carta { grid-row: span 1; grid-column: span 1; padding: 16px; }
    .carta--2x2 { grid-column: span 2; grid-row: span 2; }
    .carta--2x2 .carta__nome { font-size: 30px; }
    .carta__nome { font-size: 18px; }
    .carta--2x1 .carta__nome { font-size: 22px; }
    .carta__nome--mono { font-size: 14px; }
    .barre { height: 90px; padding: 0 16px; }
    .carta--2x2 .carta__testo { padding-left: 16px; }
    .carta__schermata, .ind--giu, .carta__stato--pill { display: none; }
    .ind { font-size: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .carta, .barre i, .cursore { animation: none; }
    .carta { transform: none; transition: box-shadow .2s; }
  }
</style>

<script>
  import { effetto, effettoFine, type NomeEffetto } from '@/lib/musica';

  const riduci = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function avvia() {
    const griglia = document.querySelector<HTMLElement>('[data-griglia]');
    if (!griglia || griglia.dataset.pronto) return;
    griglia.dataset.pronto = '1';
    griglia.querySelectorAll<HTMLElement>('.carta').forEach((carta) => {
      const nome = carta.dataset.musica as NomeEffetto | undefined;
      carta.addEventListener('pointermove', (e) => {
        if (riduci() || e.pointerType === 'touch') return;
        const r = carta.getBoundingClientRect();
        const px = Math.max(0, Math.min(100, ((e.clientX - r.left) / r.width) * 100));
        const py = Math.max(0, Math.min(100, ((e.clientY - r.top) / r.height) * 100));
        carta.style.setProperty('--mx', `${px.toFixed(1)}%`);
        carta.style.setProperty('--my', `${py.toFixed(1)}%`);
        carta.style.setProperty('--rx', `${(((50 - py) / 50) * 8).toFixed(2)}deg`);
        carta.style.setProperty('--ry', `${(((px - 50) / 50) * 8).toFixed(2)}deg`);
      });
      carta.addEventListener('pointerenter', () => {
        if (nome) { effetto(nome); window.dispatchEvent(new CustomEvent('musica:effetto', { detail: nome.toUpperCase() })); }
      });
      carta.addEventListener('pointerleave', () => {
        carta.style.setProperty('--rx', '0deg');
        carta.style.setProperty('--ry', '0deg');
        effettoFine();
        window.dispatchEvent(new CustomEvent('musica:effetto', { detail: '' }));
      });
    });
  }
  avvia();
  document.addEventListener('astro:page-load', avvia);
</script>
