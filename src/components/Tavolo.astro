---
import TavoloSvg from '@/components/TavoloSvg.astro';
---

<div class="tavolo" data-tavolo>
  <TavoloSvg />
  <p class="tavolo__didascalia" aria-live="polite">
    <span class="tavolo__pallino" data-pallino aria-hidden="true"></span>
    <span data-didascalia>Benvenuto sul mio tavolo. Tocca pure, non si rompe niente.</span>
  </p>
  <div class="viaggio" data-viaggio aria-hidden="true">
    <div class="viaggio__disco" data-disco>
      <svg class="viaggio__orbite" viewBox="-60 -60 120 120" aria-hidden="true">
        <g fill="none" stroke="#9FC3FF" stroke-opacity=".5" stroke-width=".8"><circle r="14"/><circle r="23"/><circle r="33"/><circle r="45"/></g>
        <circle r="6" fill="#F3CC6A"/>
      </svg>
    </div>
  </div>
</div>

<style is:global>
  /* Tavolo: strati, oggetti, animazioni a riposo. Globale perché lo SVG arriva da un altro file. */
  .tavolo { position: relative; width: 100%; max-width: 560px; min-width: 0; }
  .tavolo__svg {
    display: block; width: 100%; height: auto; border-radius: var(--raggio);
    filter: drop-shadow(0 30px 40px rgba(26, 29, 43, 0.3));
    --px: 0; --py: 0;
  }
  .strato { transition: transform 0.9s var(--curva-arrivo); will-change: transform; }
  .strato--lontano { transform: translate(calc(var(--px) * 1.5px), calc(var(--py) * 1.5px)); }
  .strato--medio { transform: translate(calc(var(--px) * 3px), calc(var(--py) * 3px)); }
  .strato--vicino { transform: translate(calc(var(--px) * 6px), calc(var(--py) * 6px)); }
  .ogg {
    cursor: pointer; transform-box: fill-box; transform-origin: center;
    transition: transform 0.35s var(--curva-arrivo);
  }
  .ogg:hover, .ogg:focus-visible { transform: translateY(-4px) scale(1.03); outline: none; }
  .ogg:focus-visible > g { filter: drop-shadow(0 0 0 3px var(--blu)); }

  .tavolo__didascalia {
    margin: 12px 0 0; min-height: 20px; padding: 0 8px;
    font-family: var(--font-mono); font-size: 12px; line-height: 1.5; letter-spacing: 0.02em;
    color: var(--inchiostro); text-align: center;
    display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap;
  }
  .tavolo__pallino { width: 8px; height: 8px; border-radius: 50%; background: #c3c8d6; transition: background 0.3s; }

  .vapore{animation:vapore 3.2s ease-in-out infinite;transform-box:fill-box;transform-origin:bottom}
  .vapore:nth-child(2){animation-delay:-1.1s}.vapore:nth-child(3){animation-delay:-2.2s}
  @keyframes vapore{0%{opacity:0;transform:translateY(6px) scaleY(.7)}30%{opacity:.7}100%{opacity:0;transform:translateY(-22px) scaleY(1.2)}}
  .moneta{animation:gira 6s ease-in-out infinite;transform-box:fill-box;transform-origin:center}
  .moneta:nth-child(2){animation-delay:-2s}.moneta:nth-child(3){animation-delay:-4s}
  @keyframes gira{0%,100%{transform:scaleX(1)}50%{transform:scaleX(.72)}}
  .cartaScivola{animation:scivola 7s ease-in-out infinite;transform-box:fill-box;transform-origin:center}
  @keyframes scivola{0%,60%,100%{transform:translate(0,0) rotate(0)}75%{transform:translate(18px,-6px) rotate(6deg)}90%{transform:translate(18px,-6px) rotate(6deg)}}
  .stellina{animation:brilla 3.4s ease-in-out infinite;transform-box:fill-box;transform-origin:center}
  .stellina:nth-child(2n){animation-delay:-1.2s}.stellina:nth-child(3n){animation-delay:-2.3s}
  @keyframes brilla{0%,100%{opacity:.35}50%{opacity:1}}
  .lenteBob{animation:bob 5s ease-in-out infinite;transform-box:fill-box;transform-origin:center}
  @keyframes bob{0%,100%{transform:translate(0,0)}50%{transform:translate(0,-3px)}}
  .nuova{animation:entraCarta 8s cubic-bezier(.2,.8,.2,1) infinite;transform-box:fill-box;transform-origin:center}
  @keyframes entraCarta{0%,55%{opacity:0;transform:translate(40px,-30px) rotate(8deg) scale(1.15)}68%,88%{opacity:1;transform:translate(0,0) rotate(0) scale(1)}96%,100%{opacity:0;transform:translate(0,0) rotate(0) scale(1)}}
  .tasto{animation:battuta 3.6s ease-in-out infinite;fill:#3A4060}
  .tasto.k2{animation-delay:.25s}.tasto.k3{animation-delay:.5s}.tasto.k4{animation-delay:.75s}.tasto.k5{animation-delay:1s}.tasto.k6{animation-delay:1.25s}.tasto.k7{animation-delay:1.5s}
  @keyframes battuta{0%,100%{fill:#3A4060}4%{fill:#C9D1E3}10%{fill:#3A4060}}
  .bacch1,.bacch2{transform-box:fill-box;transform-origin:4% 50%;animation:suona 1.3s ease-in-out infinite}
  .bacch2{animation-delay:-.65s}
  @keyframes suona{0%,100%{transform:rotate(0)}18%{transform:rotate(-2.2deg)}30%{transform:rotate(.6deg)}42%{transform:rotate(0)}}

  /* Transizione di scena: un disco parte dall'oggetto cliccato e copre lo schermo. */
  .viaggio { position: fixed; inset: 0; z-index: 50; pointer-events: none; display: none; }
  .viaggio--attivo { display: block; }
  .viaggio__disco { position: absolute; border-radius: 50%; transform-origin: center; will-change: transform; }
  .viaggio__disco--caffe {
    background: radial-gradient(circle at 42% 38%, #6b4529 0%, #4a2e1b 45%, #2c1a0e 100%);
    box-shadow: inset 0 0 0 6px #fff, inset 0 0 0 9px #dadfea;
  }
  .viaggio__disco--cielo {
    background: radial-gradient(circle at 50% 50%, #2b54ac 0%, #1a2f66 70%, #0f1c40 100%);
    box-shadow: inset 0 0 0 6px #f6f7fb, inset 0 0 0 8px #f3cc6a;
  }
  .viaggio__disco--lente {
    background: radial-gradient(circle at 35% 30%, rgba(255,255,255,.35), rgba(191,217,247,.12) 50%, rgba(127,176,232,.22) 100%);
    box-shadow: inset 0 0 0 10px #1a1d2b, inset 0 0 0 13px #f3cc6a;
  }
  .viaggio__orbite { position: absolute; inset: 0; width: 100%; height: 100%; display: none; }
  .viaggio__disco--cielo .viaggio__orbite { display: block; }

  @media (prefers-reduced-motion: reduce) {
    .strato { transition: none; transform: none !important; }
    .vapore, .moneta, .cartaScivola, .stellina, .lenteBob, .nuova, .tasto, .bacch1, .bacch2 { animation: none; }
  }
</style>

<script>
  import { animate } from 'motion';
  import { navigate } from 'astro:transitions/client';
  import { faseLunare, nomeFaseLunare, longitudine, type Pianeta } from '@/lib/cielo';
  import { alterna, attiva, onCambio, tac } from '@/lib/musica';

  const COLORI: Record<string, string> = { 1: '#3D6BC2', 2: '#E8B33C', 3: '#D4634A', 4: '#D4634A', 5: '#E8B33C', 6: '#3D6BC2', 8: '#6D5BC9', 9: '#2F8A6B' };
  const RIPOSO = 'Benvenuto sul mio tavolo. Tocca pure, non si rompe niente.';
  const riduci = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function didascalie(musicaAccesa: boolean): Record<string, string> {
    const luna = nomeFaseLunare(faseLunare());
    return {
      1: 'Il raccoglitore: i progetti, uno per tasca.',
      2: `Il sistema solare interno, aggiornato a oggi. Luna ${luna}. Marte è quello rosso.`,
      3: 'Un caffè? Scrivimi, lo offro io. Virtualmente.',
      4: musicaAccesa ? 'Musica accesa. Clicca per il silenzio: i vicini ringraziano.' : "Suono la batteria da un paio d'anni. Clicca e parte la musica.",
      5: 'Monete e fiches: colleziono, non gioco. Quasi.',
      6: "Mazzi di carte da gioco. L'ultimo non l'ho ancora aperto.",
      8: 'La lente: tutta la collezione, ingrandita.',
      9: 'La tastiera: qui nascono gli esperimenti.',
    };
  }

  function avvia() {
    const radice = document.querySelector<HTMLElement>('[data-tavolo]');
    if (!radice || radice.dataset.pronto) return;
    radice.dataset.pronto = '1';
    const svg = radice.querySelector<SVGSVGElement>('.tavolo__svg')!;
    const didascalia = radice.querySelector<HTMLElement>('[data-didascalia]')!;
    const pallino = radice.querySelector<HTMLElement>('[data-pallino]')!;
    const viaggio = radice.querySelector<HTMLElement>('[data-viaggio]')!;
    const disco = radice.querySelector<HTMLElement>('[data-disco]')!;

    // pianeti nelle posizioni di oggi
    (['mercurio', 'venere', 'terra', 'marte'] as Pianeta[]).forEach((p) => {
      const g = svg.querySelector<SVGGElement>(`[data-pianeta="${p}"]`);
      if (g) g.style.transform = `rotate(${-longitudine(p)}deg)`;
    });

    // parallasse leggera
    let fermo = true;
    const muovi = (e: PointerEvent) => {
      if (riduci() || e.pointerType === 'touch') return;
      const r = svg.getBoundingClientRect();
      const nx = ((e.clientX - (r.left + r.width / 2)) / r.width) * 2;
      const ny = ((e.clientY - (r.top + r.height / 2)) / r.height) * 2;
      svg.style.setProperty('--px', String(Math.max(-1, Math.min(1, -nx))));
      svg.style.setProperty('--py', String(Math.max(-1, Math.min(1, -ny))));
      fermo = false;
    };
    const ferma = () => {
      if (fermo) return;
      svg.style.setProperty('--px', '0');
      svg.style.setProperty('--py', '0');
      fermo = true;
    };
    radice.addEventListener('pointermove', muovi);
    radice.addEventListener('pointerleave', ferma);

    // etichette
    const mostra = (n: string | null) => {
      const t = didascalie(attiva());
      didascalia.textContent = n && t[n] ? t[n] : RIPOSO;
      pallino.style.background = n && COLORI[n] ? COLORI[n] : '#c3c8d6';
    };
    svg.querySelectorAll<SVGElement>('[data-oggetto]').forEach((el) => {
      const n = el.dataset.oggetto ?? null;
      el.addEventListener('pointerenter', () => mostra(n));
      el.addEventListener('focus', () => mostra(n));
      el.addEventListener('pointerleave', () => mostra(null));
      el.addEventListener('blur', () => mostra(null));
    });
    onCambio(() => mostra(document.activeElement?.closest('[data-oggetto]') ? (document.activeElement as HTMLElement).dataset.oggetto ?? null : null));

    // bacchette: musica
    svg.querySelector('[data-azione="musica"]')?.addEventListener('click', (e) => {
      e.preventDefault();
      void alterna();
    });

    // transizioni di scena
    const parti = async (tipo: 'caffe' | 'cielo' | 'lente', origine: Element, destinazione: string) => {
      tac();
      if (riduci()) { if (tipo === 'lente') scorri(); else await navigate(destinazione); return; }
      const r = origine.getBoundingClientRect();
      const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
      const raggio = Math.max(r.width, r.height) / 2;
      const vw = window.innerWidth, vh = window.innerHeight;
      const lontano = Math.max(Math.hypot(cx, cy), Math.hypot(vw - cx, cy), Math.hypot(cx, vh - cy), Math.hypot(vw - cx, vh - cy));
      const scala = (lontano * 1.08) / raggio;
      disco.className = `viaggio__disco viaggio__disco--${tipo}`;
      Object.assign(disco.style, { left: `${cx - raggio}px`, top: `${cy - raggio}px`, width: `${raggio * 2}px`, height: `${raggio * 2}px`, transform: 'scale(1)', opacity: '1' });
      viaggio.classList.add('viaggio--attivo');
      const orbite = disco.querySelector<SVGElement>('.viaggio__orbite');
      if (orbite) orbite.style.transform = 'rotate(0deg) scale(1)';
      const curva = [0.16, 1, 0.3, 1] as const;
      if (tipo === 'lente') {
        animate(disco, { transform: ['scale(1)', `scale(${(scala * 0.9).toFixed(3)})`], opacity: [1, 0] }, { duration: 0.8, ease: curva });
        window.setTimeout(scorri, 150);
        window.setTimeout(() => viaggio.classList.remove('viaggio--attivo'), 850);
        return;
      }
      const anim = animate(disco, { transform: ['scale(1)', `scale(${scala.toFixed(3)})`] }, { duration: 0.85, ease: curva });
      if (orbite) animate(orbite, { transform: ['rotate(0deg) scale(1)', 'rotate(180deg) scale(0.35)'], opacity: [1, 0] }, { duration: 0.85, ease: curva });
      sessionStorage.setItem('arrivo', tipo);
      await anim.finished;
      await navigate(destinazione);
    };
    const scorri = () => document.querySelector('#collezione')?.scrollIntoView({ behavior: riduci() ? 'auto' : 'smooth', block: 'start' });

    const collega = (n: string, tipo: 'caffe' | 'cielo' | 'lente', dest: string) => {
      const el = svg.querySelector<SVGElement>(`[data-oggetto="${n}"]`);
      el?.addEventListener('click', (e) => { e.preventDefault(); void parti(tipo, el, dest); });
    };
    collega('3', 'caffe', '/contatti');
    collega('2', 'cielo', '/chi-sono');
    collega('8', 'lente', '#collezione');
    svg.querySelector('[data-oggetto="1"]')?.addEventListener('click', (e) => { e.preventDefault(); tac(); scorri(); });
  }

  avvia();
  document.addEventListener('astro:page-load', avvia);
  document.addEventListener('astro:after-swap', () => {
    document.querySelector('[data-viaggio]')?.classList.remove('viaggio--attivo');
  });
</script>
